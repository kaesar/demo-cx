  },
  "Actions": [
    {
      "Identifier": "Saludo",
      "Type": "MessageParticipant",
      "Transitions": { "NextAction": "PedirDocumento", "Errors": [{ "NextAction": "Despedida", "ErrorType": "NoMatchingError" }] },
      "Parameters": { "Text": "Bienvenido a la línea de agendamiento de citas. " }
    },
    {
      "Identifier": "PedirDocumento",
      "Type": "GetParticipantInput",
      "Transitions": { "NextAction": "LookupPaciente", "Errors": [{ "NextAction": "Despedida", "ErrorType": "NoMatchingError" }] },
