{
  "Version": "2019-10-30",
  "StartAction": "Saludo",
  "Metadata": {
    "entryPointPosition": { "x": 40, "y": 40 },
    "ActionMetadata": {
      "Saludo": { "position": { "x": 80, "y": 80 } },
      "PedirDocumento": { "position": { "x": 280, "y": 80 } },
      "LookupPaciente": { "position": { "x": 480, "y": 80 } },
      "MenuPrincipal": { "position": { "x": 680, "y": 80 } },
      "ColaAgente": { "position": { "x": 880, "y": 80 } },
      "Despedida": { "position": { "x": 680, "y": 280 } }
