        "InputType": "DTMF",
        "DTMFConfiguration": { "InputDurationInSeconds": 10 }
      }
    },
    {
      "Identifier": "LookupPaciente",
      "Type": "InvokeLambdaFunction",
      "Transitions": { "NextAction": "MenuPrincipal", "Errors": [{ "NextAction": "MenuPrincipal", "ErrorType": "NoMatchingError" }] },
      "Parameters": {
        "LambdaFunctionARN": "ARN_DE_PATIENT_LOOKUP_SE_CONFIGURA_AL_DESPLEGAR",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInputParameters": { "documentId": "$.External.DTMFInput" }
      }
    },
    {
      "Identifier": "MenuPrincipal",
      "Type": "GetParticipantInput",
      "Transitions": { "NextAction": "Despedida", "Conditions": [{ "NextAction": "ColaAgente", "Condition": { "Operator": "Equals", "Operands": ["0"] } }], "Errors": [{ "NextAction": "Despedida", "ErrorType": "NoMatchingError" }] },
      "Parameters": {
        "Text": "Marque 1 para agendar, 2 para consultar o modificar, 3 para cancelar, o 0 para hablar con un agente. ",
        "InputType": "DTMF",
        "DTMFConfiguration": { "InputDurationInSeconds": 8 }
      }
    },
    {
      "Identifier": "ColaAgente",
      "Type": "TransferToQueue",
      "Transitions": { "NextAction": "Despedida", "Errors": [{ "NextAction": "Despedida", "ErrorType": "NoMatchingError" }] },
      "Parameters": {}
    },
    {
      "Identifier": "Despedida",
      "Type": "DisconnectParticipant",
      "Transitions": {},
      "Parameters": {}
    }
  ]
